env
__pycache__/

# uv-created environments. `env` above is the old hand-rolled venv the service
# still runs out of; `.venv` is what `uv sync` makes, and `.venv-uv` is the
# scratch one I built beside it to prove uv worked before touching anything.
.venv
.venv-uv

# Runtime output. Both of these are written by every run, so tracking them
# meant the tree was dirty the moment I drove the car. The versions already
# committed stay in history -- in particular the app.log from 2025-04-27,
# which is the only telemetry I have of the ESC at neutral 1575.
app.log
app.log.*
# log/ whole, not log/*.csv. It was the CSVs for a long time, and then the
# car started writing .mcap recordings in there and walked straight past a
# rule that names one extension.
log/

# Downloaded model weights and the archives they arrive in.
#
# This is the rule I actually needed. The checkout on the car is sitting on
# faster_rcnn_openimages_v4_inception_resnet_v2.tar.gz at 229 MiB, four
# yolov5/yolov8 .pt files at another 45 MiB, and models/ and labels/ beside
# them -- every one of them untracked, with nothing stopping them. One
# absent-minded `git add -A` on the car puts a 229 MiB tarball into a public
# repo, and history is forever: no later `git rm` takes it back out, every
# clone from then on pays for it, and the only fix is a rewrite that breaks
# every checkout anybody already has. None of it is mine to begin with, it is
# all redownloadable from upstream, so none of it belongs in here.
#
# *.pb and *.tflite are in the list on purpose even though saved_model.pb and
# model.tflite were tracked until I deleted them. Weights are weights whether
# I committed them once or not.
*.pt
*.pth
*.onnx
# Except the one the tests run through onnxruntime: a 77 KB smoke policy,
# trained on two autopilot sessions, there so the runtime is tested against a
# real exported graph and not only a stub. It drives nothing.
!tests/fixtures/*.onnx
*.tflite
*.pb
*.h5
# depthai compiles its own models down to these, and will again the day I give
# the OAK-D a neural network to run.
*.blob
*.superblob
# Archives. Nothing in this project is a .tar.gz I wrote.
*.tar.gz
*.tgz
*.zip
# The two asset directories the retired TensorFlow experiment wanted. Neither
# has ever existed anywhere but on the car.
models/
labels/

# Not a dependency file any more, and not to be treated as one. This project is
# on uv: pyproject.toml plus uv.lock is the whole answer to "what gets
# installed", and the lock pins the entire graph with hashes, which a six-line
# requirements.txt never did. The copy on the car is from April 2025 and names
# six packages where pyproject names nine, so `pip install -r` against it would
# quietly build a different environment than the one the car is running. It has
# never been tracked in this repo and it is not going to start now. The one
# sitting on the car is safe to delete next time I am in that directory.
requirements.txt

# pytest's cache.
.pytest_cache/

# What `uv sync` leaves behind when it installs crawler/ as editable.
*.egg-info/
build/

# Where I send a test run's output to read it back.
out.txt

# Where pull-recordings.sh used to drop what it fetched off the car. It puts
# them in ~/crawler/data/mcap now, outside any repo, and refuses a
# destination inside one; this stays for the copies already sitting here.
recordings/

# Any recording anywhere in the tree, and the .orig and .fixed mcap_check
# leaves beside a repaired one. The repo is public and a recording is video of
# my house. The real guard is tools/pull_mcaps.py refusing any destination
# inside a work tree; this is the belt to go with it.
*.mcap
*.mcap.orig
*.mcap.fixed
