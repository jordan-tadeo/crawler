{
  "input_contract": "depth_small",
  "representation": "profile",
  "actions": [
    "forward",
    "reverse",
    "stop"
  ],
  "uses_prev_action": true,
  "outputs": [
    "logits",
    "throttle",
    "steer",
    "mode_logits"
  ],
  "steer_scale": 0.7,
  "labels": "pad",
  "note": "untrained weights, seed 0: a test fixture for the imu input, not a driver",
  "steer_modes": [
    "unified",
    "split"
  ],
  "mode_switch": {
    "threshold": 0.7,
    "dwell_s": 0.5,
    "min_interval_s": 2.0
  },
  "mode_rear": {
    "unified": "steering_pair(front)",
    "split": 0.0
  },
  "mode_not_modelled": "split with the right stick on the rear (|rear| > split_rear_rest); the dataset drops those rows",
  "mode_switch_weight": 10.0,
  "uses_imu": true,
  "imu_features": [
    "gyro_x",
    "gyro_y",
    "gyro_z",
    "accel_x",
    "accel_y",
    "accel_z",
    "accel_peak",
    "gyro_peak",
    "valid",
    "up_x",
    "up_y",
    "up_z",
    "tilt_valid"
  ],
  "imu_window": 5,
  "imu_tilt": false,
  "imu_scales": {
    "gyro_rad_s": 2.0,
    "accel_m_s2": 10.0,
    "clip": 3.0,
    "max_age_ms": 250.0,
    "gap_s": 0.25
  }
}